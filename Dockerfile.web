# Builds the React SPA and serves it via nginx, which also reverse-proxies /api
# to the api container. This is the public entry point (ports 80/443).
# NOTE: build this AFTER the Phase 3 frontend swap (see PHASE3_FRONTEND_SWAP.md).

# ── build the SPA ────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# API is same-origin behind nginx, so the SPA calls "/api".
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# ── serve with nginx ─────────────────────────────────────────────────────────
FROM nginx:1.27-alpine
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80 443
