# docker-compose environment — copy to .env next to docker-compose.yml.
# These feed the postgres, api, and backup services.

# Database
# NOTE: the api container refuses to BOOT on any of the placeholder values in
# this file (see server/src/config.ts). A placeholder that boots is a
# placeholder that reaches production, so both secrets below must really be
# replaced. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PGUSER=cms
PGPASSWORD=change-me-strong
PGDATABASE=eprom_cms

# API auth
# JWT_SECRET is the password to EVERY account at once — anyone holding it can
# mint a token for any user id with role ADMIN, and every check in authz.ts sits
# downstream of "the signature is valid". Minimum 32 characters, and it must not
# contain the words below or the API will refuse to start.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12
BOOTSTRAP_ADMIN_EMAIL=tarekmoh123@gmail.com
ALLOW_SIGNUP=false

# Browser origins allowed to call the API. Behind nginx the SPA is same-origin,
# so list the DNS name(s) users hit.
CORS_ORIGINS=https://cms.eprom.local

# Nightly sweep inside the api container (server/src/jobs/). See
# server/.env.example for the full list; defaults are fine for the VM.
JOBS_ENABLED=true
JOBS_HOUR=2

# One reverse proxy (the `web` nginx container) sits in front of the API.
TRUST_PROXY=1

# Nightly backup retention, in days (deploy/backup.sh).
BACKUP_RETENTION_DAYS=30
