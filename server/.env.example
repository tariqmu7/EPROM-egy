# ─── EPROM CMS API — environment ─────────────────────────────────────────────
# Copy to .env and fill in. On the VM these are injected by docker-compose.

# HTTP
PORT=4000
# Comma-separated list of allowed browser origins (the SPA). In production this
# is the internal DNS name; nginx serves the SPA same-origin so it can be tight.
CORS_ORIGINS=http://localhost:5173,https://cms.eprom.local

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=cms
PGPASSWORD=change-me
PGDATABASE=eprom_cms
# When true, use SSL to reach Postgres (not needed for the in-VM container).
PGSSL=false

# Auth
# Long random secret used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Access-token lifetime.
JWT_EXPIRES_IN=12h
# bcrypt cost factor (10-12 is standard).
BCRYPT_ROUNDS=12

# Bootstrap admin — this email is treated as ADMIN before any user holds the
# ADMIN role (first-run / recovery). Mirrors VITE_BOOTSTRAP_ADMIN_EMAIL.
BOOTSTRAP_ADMIN_EMAIL=tarekmoh123@gmail.com

# Whether self sign-up is allowed (creates a PENDING user needing admin approval).
# Off by default — admins create accounts. BOOTSTRAP_ADMIN_EMAIL is exempt.
ALLOW_SIGNUP=false

# ── Scheduled work (server/src/jobs/) ───────────────────────────────────────
# The nightly sweep: re-bands every certificate, chases assessments that are due
# or overdue, chases overdue development-plan items, and sends each manager one
# weekly team digest. Runs INSIDE the api process (no crontab on the VM).
# Set to false only to silence it — nothing else in the system does this work.
JOBS_ENABLED=true
# Local server time. 02:00 sits after the nightly pg_dump and before anyone logs in.
JOBS_HOUR=2
JOBS_MINUTE=0
# If the last successful sweep is older than JOBS_CATCH_UP_AFTER_HOURS (e.g. the
# VM was rebooted through the night), run one shortly after boot instead of
# skipping the night entirely.
JOBS_CATCH_UP_ON_BOOT=true
JOBS_CATCH_UP_AFTER_HOURS=20
