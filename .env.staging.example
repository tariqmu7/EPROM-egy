# STAGING environment — copy to .env.staging on the VM.
#
#   cp .env.staging.example .env.staging
#
# Staging runs as a separate compose project (`ecms-staging`) with its own
# database volume, so these values are independent of production's .env.
# Use DIFFERENT secrets than production: staging is lower-trust, and a leaked
# staging JWT_SECRET must never unlock production tokens.

# Database (own volume — safe to wipe and reload from a prod dump)
PGUSER=cms
PGPASSWORD=change-me-staging-password
PGDATABASE=eprom_cms

# API auth
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-different-from-production
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12
BOOTSTRAP_ADMIN_EMAIL=tarekmoh123@gmail.com
ALLOW_SIGNUP=true

# The port staging listens on (production uses 8080). Browsed directly at
# http://<vm-ip>:8081 — no subdomain and no host-nginx block needed.
WEB_PORT=8081

# Browser origin staging is reached on. Put the VM's actual LAN IP here.
# (The SPA is same-origin behind the container's nginx, so this mainly matters
#  if you ever point a local `npm run dev` at the staging API.)
CORS_ORIGINS=http://192.168.1.100:8081
